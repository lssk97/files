site_name: Motor de Pricing - Documentação
site_description: Documentação técnica do sistema de cálculo de custos, preços e intercâmbio.
site_author: Seu Nome / Sua Empresa

theme:
  name: material
  language: pt
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.top
    - search.suggest
    - search.highlight
    - content.code.copy
  palette:
    - scheme: default
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-7
        name: Mudar para modo escuro
    - scheme: slate
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-4
        name: Mudar para modo claro

plugins:
  - search
  - mkdocstrings:
      handlers:
        python:
          options:
            show_source: true
            show_root_heading: true
            heading_level: 2

nav:
  - Home: index.md
  - Motores Principais:
    - Visão Geral: motores/motor_principal.md
    - Motor de Custos: motores/custos.md
    - Motor de Preços: motores/precos.md
    - Motor de Intercâmbio: motores/intercambio.md
  - Financeiro:
    - Profit & Loss (P&L): analises/profit_and_loss.md
  - Módulos Suporte & Schemas:
    - Regras Gerais & Utils: suporte/geral.md
    - Schemas e Validações: suporte/schemas.md
  - Dados:
    - Bases de Suporte (Parquet): databases.md
