import json
from databricks.sdk import WorkspaceClient

w = WorkspaceClient()

# 1. Captura o Access Token ativo gerado pelo SDK
headers = w.config.authenticate()
token = headers.get("Authorization", "").replace("Bearer ", "")

print("=== TOKEN DE ACESSO ATUAL (Validade ~1h) ===")
print(token)

# 2. Tenta extrair a credencial MSAL / OAuth armazenada internamente na memória do SDK
try:
    credential = w.config._credentials
    # Inspeciona os atributos privados da credencial
    for attr in dir(credential):
        if "token" in attr.lower() or "cache" in attr.lower():
            val = getattr(credential, attr, None)
            if val:
                print(f"\n[+] Achado no atributo '{attr}':")
                print(val)
except Exception as e:
    print(f"\nNão foi possível inspecionar a memória interna: {e}")
