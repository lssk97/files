import json
from pathlib import Path
from azure.identity import InteractiveBrowserCredential, TokenCachePersistenceOptions

# Define um arquivo local seguro para gravar o cache MSAL do Python
cache_options = TokenCachePersistenceOptions(name="databricks_powerautomate_cache")

# GUID Público do Azure Databricks
DATABRICKS_RESOURCE = "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d/.default"

print("Abrindo navegador para autenticação...")
credential = InteractiveBrowserCredential(
    token_cache_persistence_options=cache_options
)

# Solicita o token para o Databricks
token_object = credential.get_token(DATABRICKS_RESOURCE)
print("\n[SUCCESS] Autenticado com sucesso!")

# Lê o cache do MSAL gerado no disco para extrair o Refresh Token
# No Windows, o cache persistente fica em %LOCALAPPDATA%\.IdentityService
cache_path = Path.home() / "AppData" / "Local" / ".IdentityService" / "msal.cache"

if cache_path.exists():
    with open(cache_path, "r", encoding="utf-8") as f:
        try:
            raw_data = f.read()
            # Tenta converter se não estiver criptografado pelo SO
            cache_json = json.loads(raw_data)
            print("\n=== REFRESH TOKENS ENCONTRADOS NO CACHE ===")
            for key, item in cache_json.get("RefreshToken", {}).items():
                print(f"\nRefresh Token: {item.get('secret')}")
        except Exception:
            print(f"\nO arquivo de cache foi gerado em: {cache_path}")
            print("O arquivo está protegido pelo DPAPI do Windows.")
