from databricks.sdk import WorkspaceClient

# Inicializa o cliente usando as credenciais que já funcionam no seu ambiente
w = WorkspaceClient()

# Captura a configuração de autenticação do SDK
config = w.config

print("=== INFORMAÇÕES DE AUTENTICAÇÃO DO SDK ===")
print(f"Host: {config.host}")
print(f"Auth Type: {config.auth_type}")

# Tenta extrair os tokens da credencial ativa
try:
    # Obtém o token de acesso e headers ativos gerados pelo SDK
    headers = config.authenticate()
    access_token = headers.get("Authorization", "").replace("Bearer ", "")
    print(f"\n[+] Access Token (Validade 1h): {access_token[:20]}...")
    
    # Se a autenticação do SDK utilizou OAuth/MSAL, o refresh token fica no cache interno
    if hasattr(config, "_credentials") and hasattr(config._credentials, "token_cache"):
        print("\n[+] Buscando no cache MSAL...")
        # Lendo o cache de tokens do MSAL internamente
        cache = config._credentials.token_cache
        # O método serialize() expõe a estrutura JSON do cache com o refresh_token
        import json
        cache_data = json.loads(cache.serialize())
        
        refresh_tokens = cache_data.get("RefreshToken", {})
        for key, rt_info in refresh_tokens.items():
            print(f"\n Refresh Token encontrado: {rt_info.get('secret')}")
except Exception as e:
    print(f"\nErro ao extrair diretamente do objeto: {e}")
