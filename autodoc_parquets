from pathlib import Path
import polars as pl

# Caminho do diretório de databases do projeto
db_dir = Path("motor_de_pricing/databases")

markdown_output = """# Base de Dados de Suporte (Parquet)

Esta página documenta os schemas de todas as tabelas em formato `.parquet` utilizadas pelos motores de cálculo.

---
"""

# Agrupa por subdiretório
for subfolder in sorted(db_dir.glob("**/*")):
    # Pega apenas arquivos parquet diretamente na pasta atual
    parquet_files = sorted([f for f in subfolder.glob("*.parquet") if f.parent == subfolder])
    if not parquet_files:
        continue

    relative_path = subfolder.relative_to(db_dir)
    markdown_output += f"\n## Categoria: `{relative_path}`\n\n"

    for file in parquet_files:
        # Lê apenas as primeiras 10 linhas via Polars para inspecionar schema e exemplos
        df = pl.read_parquet(file, n_rows=10)
        file_name = file.name

        markdown_output += f"### 📄 `{file_name}`\n"
        markdown_output += f"* **Caminho:** `{file.relative_to(db_dir.parent)}`\n"
        markdown_output += f"* **Total de Colunas:** {len(df.columns)}\n\n"

        markdown_output += "| Coluna | Tipo de Dado | Exemplo |\n"
        markdown_output += "| :--- | :--- | :--- |\n"

        # Itera sobre o schema no Polars (dict de nome: dtype)
        for col, dtype in df.schema.items():
            non_nulls = df[col].drop_nulls()
            sample_val = str(non_nulls[0]) if len(non_nulls) > 0 else "N/A"

            # Trata tamanho da string para não quebrar a tabela do Markdown
            if len(sample_val) > 30:
                sample_val = sample_val[:27] + "..."

            markdown_output += f"| `{col}` | `{dtype}` | `{sample_val}` |\n"

        markdown_output += "\n"

# Salva a documentação diretamente na pasta docs/ do MkDocs
output_path = Path("docs/databases.md")
output_path.parent.mkdir(parents=True, exist_ok=True)
output_path.write_text(markdown_output, encoding="utf-8")

print(f"✅ Documentação gerada com sucesso em: {output_path}")
