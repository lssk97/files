from pathlib import Path
from collections import defaultdict
import polars as pl

# Tenta localizar a pasta databases importando a biblioteca diretamente
def find_db_dir() -> Path:
    try:
        import motor_de_pricing
        package_root = Path(motor_de_pricing.__file__).resolve().parent
        db_dir = package_root / "databases"
        if db_dir.exists():
            return db_dir
    except ImportError:
        pass

    # Fallbacks de caminhos locais comuns caso a biblioteca não esteja instalada no venv
    project_root = Path(__file__).resolve().parent.parent
    possible_paths = [
        project_root / "motor_de_pricing" / "databases",
        project_root / "src" / "motor_de_pricing" / "databases",
    ]

    for path in possible_paths:
        if path.exists():
            return path

    raise FileNotFoundError(
        "Não foi possível encontrar a pasta 'databases'. "
        "Certifique-se de que o motor_de_pricing está instalado no ambiente ou presente no projeto."
    )

