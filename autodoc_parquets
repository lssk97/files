from pathlib import Path
from collections import defaultdict
import polars as pl

# Tenta localizar a pasta databases importando a biblioteca diretamente
def find_db_dir() -> Path:
    try:
        import motor_de_pricing
        package_root = Path(motor_de_pricing.__file__).resolve().parent
        db_dir = package_root / "databases"
        if db_dir.exists():
            return db_dir
    except ImportError:
        pass

    # Fallbacks de caminhos locais comuns caso a biblioteca não esteja instalada no venv
    project_root = Path(__file__).resolve().parent.parent
    possible_paths = [
        project_root / "motor_de_pricing" / "databases",
        project_root / "src" / "motor_de_pricing" / "databases",
    ]

    for path in possible_paths:
        if path.exists():
            return path

    raise FileNotFoundError(
        "Não foi possível encontrar a pasta 'databases'. "
        "Certifique-se de que o motor_de_pricing está instalado no ambiente ou presente no projeto."
    )

PROJECT_ROOT = Path(__file__).resolve().parent.parent
OUTPUT_FILE = PROJECT_ROOT / "docs" / "databases.md"

def generate_docs():
    try:
        db_dir = find_db_dir()
    except FileNotFoundError as e:
        print(f"❌ Erro: {e}")
        return

    print(f"🔍 Pasta de databases localizada em: {db_dir}")

    # Busca todos os arquivos .parquet recursivamente
    all_parquet_files = sorted(list(db_dir.rglob("*.parquet")))

    if not all_parquet_files:
        print(f"⚠️ Nenhum arquivo .parquet encontrado dentro de: {db_dir}")
        return

    print(f"📦 Encontrados {len(all_parquet_files)} arquivos .parquet. Gerando documentação...")

    # Agrupa arquivos pela subpasta/categoria
    files_by_category = defaultdict(list)
    for pfile in all_parquet_files:
        category = pfile.parent.relative_to(db_dir)
        files_by_category[category].append(pfile)

    markdown_output = """# Base de Dados de Suporte (Parquet)

Esta página documenta os schemas de todas as tabelas em formato `.parquet` utilizadas pelos motores de cálculo.

---
"""

    for category, files in files_by_category.items():
        markdown_output += f"\n## Categoria: `{category}`\n\n"

        for file in files:
            try:
                # Lê apenas as primeiras 5 linhas com Polars
                df = pl.read_parquet(file, n_rows=5)
                file_name = file.name
                
                # Se estiver dentro do projeto, mostra caminho relativo limpo
                try:
                    rel_path = file.relative_to(PROJECT_ROOT)
                except ValueError:
                    rel_path = f"motor_de_pricing/databases/{category}/{file_name}"

                markdown_output += f"### 📄 `{file_name}`\n"
                markdown_output += f"* **Caminho:** `{rel_path}`\n"
                markdown_output += f"* **Total de Colunas:** {len(df.columns)}\n\n"

                markdown_output += "| Coluna | Tipo de Dado | Exemplo |\n"
                markdown_output += "| :--- | :--- | :--- |\n"

                for col, dtype in df.schema.items():
                    non_nulls = df[col].drop_nulls()
                    sample_val = str(non_nulls[0]) if len(non_nulls) > 0 else "N/A"

                    # Limpa quebras de linha e limita tamanho para a tabela Markdown
                    sample_val = sample_val.replace("\n", " ")
                    if len(sample_val) > 30:
                        sample_val = sample_val[:27] + "..."

                    markdown_output += f"| `{col}` | `{dtype}` | `{sample_val}` |\n"

                markdown_output += "\n"

            except Exception as e:
                print(f"⚠️ Erro ao ler o arquivo {file.name}: {e}")
                markdown_output += f"### 📄 `{file.name}`\n"
                markdown_output += f"*Erro ao ler o schema: {e}*\n\n"

    # Salva o arquivo docs/databases.md
    OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT_FILE.write_text(markdown_output, encoding="utf-8")

    print(f"✅ Documentação gerada com sucesso em: {OUTPUT_FILE}")

# Suporte para Hook do MkDocs
def on_pre_build(config, **kwargs):
    generate_docs()

if __name__ == "__main__":
    generate_docs()
